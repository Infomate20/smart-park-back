# Modèle de configuration locale — À COPIER EN `.env` PUIS RENSEIGNER.
#
#     cp .env.example .env
#
# `.env` est ignoré par git ; ce fichier-ci est versionné et ne doit donc
# contenir aucune valeur réelle.
#
# En production, ne déployez pas de fichier .env : renseignez ces mêmes
# variables comme variables d'environnement. Elles ont la priorité.

# --- Base de données -------------------------------------------------------
# DB_URL et DB_USERNAME ont des valeurs par défaut adaptées au poste de
# développement ; ne les définissez que pour en sortir.
# Attention : une variable définie mais vide écrase la valeur par défaut.
#DB_URL=jdbc:postgresql://localhost:5432/smartpark
#DB_USERNAME=smartpark
DB_PASSWORD=

# --- Messagerie (envoi des codes OTP de connexion) -------------------------
# Compte Gmail + mot de passe d'application (pas le mot de passe du compte).
# Obligatoire : la connexion à l'application passe par un OTP envoyé par mail.
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Signature des jetons JWT ----------------------------------------------
# Obligatoire, sans valeur par défaut : une clé partagée entre installations
# permettrait de forger des jetons valides sur chacune d'elles.
# Générer une clé de 256 bits, par exemple :
#     openssl rand -hex 32
JWT_SECRET=
#JWT_EXPIRATION=3600000
#JWT_REFRESH_EXPIRATION=86400000

# --- Assistant IA (optionnel) ----------------------------------------------
# Laisser vide désactive de fait l'assistant sans empêcher le démarrage.
GROQ_API_KEY=
#GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
#GROQ_MODEL=llama-3.1-8b-instant

# --- CORS ------------------------------------------------------------------
# Origines autorisées à appeler l'API, séparées par des virgules.
# La valeur '*' est interdite (les requêtes portent des identifiants).
#CORS_ALLOWED_ORIGINS=http://localhost:4200
#CORS_ALLOWED_ORIGINS=https://parc.example.com,https://admin.example.com

# --- Divers ----------------------------------------------------------------
#SERVER_PORT=8082
